# VideoCutEditor: Worker 与 toolkit 共用这一份配置（已按项目要求纳入 Git）。
# 拉取后直接使用，无需复制 .env.example。真实模型密钥仍需在下方填写。

# Ubuntu 持久化目录
MEDIA_ROOT=/home/ops/jiangzb/videos
DATA_ROOT=/home/ops/jiangzb/video-worker-data

# 数据库密码（已生成）；Compose 自动构造 DATABASE_URL
POSTGRES_PASSWORD=9e396d29988333f7362a7ec5b99c7679a46d5c7baa7b474b

# 调用方及回调（已生成 API 令牌和 HMAC 密钥）
IFENG_TENANT_ID=ifeng
IFENG_API_KEY=a7349aa15ca43baa43cee32be773c224e9efad57078ee408
IFENG_CALLBACK_SECRET=350b1a83a5cfbfa395cdf96adbdd29bfa80244a6951c848a5a983a960e68e598
IFENG_ALLOWED_INPUT_PREFIXES=input
# 当前指向部署手册中的测试接收器；正式联调改成编辑平台内网根地址。
IFENG_CALLBACK_BASE_URL=http://videocut-smoke-callback:9000

# 任务执行容器；总并发固定为 4
RUNNER_IMAGE=videocut-runner:0.1.0
RUNNER_UID=1000:1000
RUNNER_CPUS=2
RUNNER_MEMORY=4g
RUNNER_NETWORK=bridge

# 必填：项目当前未提供可用于服务端执行的模型 API 密钥。
CODEX_API_KEY=
# 留空使用运行时默认型号及 API 地址；有指定服务时填写。
CODEX_MODEL=
CODEX_BASE_URL=

# 现有 toolkit 配音配置原样迁入；Worker 共用 DOUBAO_TTS_SPEAKER。
# Local-only credentials for the Doubao TTS smoke test. This file is git-ignored.
DOUBAO_TTS_API_KEY=892ff19b-4c93-4726-a986-7d92756162e0
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_SPEAKER=zh_female_xiaohe_uranus_bigtts
