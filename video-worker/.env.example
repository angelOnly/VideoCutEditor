# Ubuntu host paths. Do not commit the actual .env file.
MEDIA_ROOT=/home/ops/jiangzb/videos
DATA_ROOT=/home/ops/jiangzb/video-worker-data
POSTGRES_PASSWORD=replace_with_random_url_safe_password
# For running Node directly (Compose supplies its own database service address).
DATABASE_URL=postgresql://videocut:replace_with_random_url_safe_password@127.0.0.1:5432/videocut
TENANTS_FILE=config/tenants.json
RUNNER_IMAGE=videocut-runner:0.1.0
RUNNER_UID=1000:1000
RUNNER_CPUS=2
RUNNER_MEMORY=4g
RUNNER_NETWORK=bridge
CODEX_API_KEY=
# Set an explicitly selected model available to your account; omitted uses the SDK runtime default.
CODEX_MODEL=
# CODEX_BASE_URL=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
TTS_VOICE=zh_female_xiaohe_uranus_bigtts
