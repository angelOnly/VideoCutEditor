FROM node:22-bookworm-slim AS build
RUN npm install --global pnpm@11.19.0
WORKDIR /build/video-worker
COPY video-worker/package.json video-worker/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY video-worker/src ./src
COPY video-worker/scripts ./scripts
COPY video-worker/tsconfig.json ./
RUN pnpm build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ffmpeg chromium fonts-noto-cjk ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/python && /opt/python/bin/pip install --no-cache-dir requests==2.32.5 python-dotenv==1.2.1 jsonschema==4.26.0
ENV JOB_DIR=/workspace/job TOOLKIT_ROOT=/opt/toolkit
ENV PATH=/opt/python/bin:$PATH REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
RUN npm install --global pnpm@11.19.0
WORKDIR /opt/runner
COPY video-worker/deploy/runner-runtime/package.json video-worker/deploy/runner-runtime/pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile --ignore-scripts
COPY --from=build /build/video-worker/dist/runner.mjs ./runner.mjs
COPY claude-code-video-toolkit/.agents/skills/video-pipeline /opt/toolkit/.agents/skills/video-pipeline
COPY claude-code-video-toolkit/.agents/skills/remotion-best-practices /opt/toolkit/.agents/skills/remotion-best-practices
COPY claude-code-video-toolkit/.agents/skills/remotion /opt/toolkit/.agents/skills/remotion
COPY claude-code-video-toolkit/.agents/skills/ffmpeg /opt/toolkit/.agents/skills/ffmpeg
COPY claude-code-video-toolkit/tools/config.py claude-code-video-toolkit/tools/voiceover.py claude-code-video-toolkit/tools/doubao_tts.py claude-code-video-toolkit/tools/worker_tts.py claude-code-video-toolkit/tools/render_segments.py claude-code-video-toolkit/tools/inspect_assets.py /opt/toolkit/tools/
COPY claude-code-video-toolkit/templates/ifeng-scenes /opt/toolkit/templates/ifeng-scenes
WORKDIR /opt/toolkit/templates/ifeng-scenes
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN chmod -R a+rX /opt/toolkit /opt/runner
WORKDIR /workspace/job
USER 1000:1000
CMD ["node","/opt/runner/runner.mjs"]
