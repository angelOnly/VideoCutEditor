FROM node:22-bookworm-slim AS build
RUN npm install --global pnpm@11.19.0
WORKDIR /build/video-worker
COPY video-worker/package.json video-worker/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY video-worker/src ./src
COPY video-worker/scripts ./scripts
COPY video-worker/tsconfig.json ./
RUN pnpm build
RUN pnpm prune --prod --ignore-scripts

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/video-worker
COPY --from=build /build/video-worker/node_modules ./node_modules
COPY --from=build /build/video-worker/dist ./dist
COPY video-worker/package.json ./
COPY video-worker/config/templates.json video-worker/config/runtime-version.json ./config/
COPY video-worker/migrations ./migrations
# Only the canonical internal contract is needed by the controller, not the toolkit source tree.
COPY claude-code-video-toolkit/.agents/skills/video-pipeline/references/two-stage.schema.json claude-code-video-toolkit/.agents/skills/video-pipeline/references/task-v2.schema.json claude-code-video-toolkit/.agents/skills/video-pipeline/references/response-v2.schema.json /opt/toolkit/.agents/skills/video-pipeline/references/
ENV TOOLKIT_ROOT=/opt/toolkit
CMD ["node","dist/entrypoints/api.js"]
