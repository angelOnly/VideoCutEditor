{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "jobId": {
      "type": "string"
    },
    "dataList": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "dur": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 600
          },
          "durationSource": {
            "type": "string",
            "enum": [
              "estimated",
              "measured"
            ]
          },
          "narrationStartTime": {
            "type": "number",
            "minimum": 0
          },
          "narrationEndTime": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visualPlan": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 4000
              },
              "layoutPreset": {
                "type": "string",
                "enum": [
                  "full_frame",
                  "presenter_pip"
                ]
              },
              "animationPreset": {
                "type": "string",
                "enum": [
                  "none",
                  "slow_zoom",
                  "fade"
                ]
              },
              "selectionReason": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "description",
              "layoutPreset",
              "animationPreset"
            ],
            "additionalProperties": false
          },
          "extraData": {
            "type": "object",
            "properties": {
              "keywordList": {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "digitalHumanId": {
                "type": "string",
                "maxLength": 128
              },
              "videoInfoList": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "startTime": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endTime": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "role": {
                      "default": "content",
                      "type": "string",
                      "enum": [
                        "background",
                        "content",
                        "presenter"
                      ]
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "playbackRate": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 4
                    },
                    "freezeLastFrame": {
                      "type": "boolean"
                    },
                    "dur": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "sourceStartTime": {
                      "type": "number",
                      "minimum": 0
                    },
                    "sourceEndTime": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "assetId",
                    "url",
                    "startTime",
                    "endTime",
                    "role",
                    "order",
                    "dur",
                    "sourceStartTime",
                    "sourceEndTime"
                  ],
                  "additionalProperties": false
                }
              },
              "picInfoList": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "startTime": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endTime": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "role": {
                      "default": "content",
                      "type": "string",
                      "enum": [
                        "background",
                        "content",
                        "presenter"
                      ]
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "playbackRate": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 4
                    },
                    "freezeLastFrame": {
                      "type": "boolean"
                    },
                    "w": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "h": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "assetId",
                    "url",
                    "startTime",
                    "endTime",
                    "role",
                    "order",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "keywordList",
              "digitalHumanId",
              "videoInfoList",
              "picInfoList"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "content",
          "dur",
          "visualPlan",
          "extraData"
        ],
        "additionalProperties": false
      }
    },
    "materialUnderstanding": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "assetId",
          "summary",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "dataList",
    "materialUnderstanding"
  ],
  "additionalProperties": false
}
