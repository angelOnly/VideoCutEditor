{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:videocut:two-stage:1",
  "title": "Codex 本地两阶段协议 v1",
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "video-two-stage/1"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "stage": {
          "enum": [
            "analysis",
            "render"
          ]
        },
        "input": {
          "type": "object",
          "properties": {
            "scriptFile": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "requirementsFile": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "templateSnapshot": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "assetsManifest": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            }
          },
          "required": [
            "scriptFile",
            "requirementsFile",
            "templateSnapshot",
            "assetsManifest"
          ],
          "additionalProperties": false
        },
        "snapshot": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "confirmation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "planVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "planFile": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "planSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "planVersion",
                "planFile",
                "planSha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "previousArtifacts": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputSpec": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height",
            "fps"
          ],
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "executionSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "repairRounds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "executionSeconds",
            "repairRounds"
          ],
          "additionalProperties": false
        },
        "delivery": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "analysis_plan",
                "scene_mp4"
              ]
            },
            "includeWholeVideo": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "includeWholeVideo"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contractVersion",
        "taskId",
        "runId",
        "stage",
        "input",
        "snapshot",
        "confirmation",
        "previousArtifacts",
        "outputSpec",
        "limits",
        "delivery"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "analysis"
              }
            }
          },
          "then": {
            "properties": {
              "confirmation": {
                "type": "null"
              },
              "delivery": {
                "properties": {
                  "kind": {
                    "const": "analysis_plan"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "confirmation": {
                "type": "object",
                "properties": {
                  "planVersion": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "planFile": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                  },
                  "planSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "planVersion",
                  "planFile",
                  "planSha256"
                ],
                "additionalProperties": false
              },
              "delivery": {
                "properties": {
                  "kind": {
                    "const": "scene_mp4"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "submission": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "scriptFile": {
          "type": "string",
          "minLength": 1
        },
        "requirementsFile": {
          "type": "string",
          "minLength": 1
        },
        "templateFile": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "image",
                  "video",
                  "audio",
                  "source",
                  "reference",
                  "font"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "path",
              "kind",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "outputSpec": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "height": {
              "type": "integer",
              "minimum": 2,
              "multipleOf": 2
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height",
            "fps"
          ],
          "additionalProperties": false
        },
        "includeWholeVideo": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "properties": {
            "executionSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "repairRounds": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "executionSeconds",
            "repairRounds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "taskId",
        "scriptFile",
        "requirementsFile",
        "templateFile",
        "assets",
        "outputSpec"
      ],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "video-two-stage/1"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              "text": {
                "type": "string"
              },
              "sourceMapping": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unit": {
                      "const": "unicode_codepoints"
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "unit"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "timing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "estimated"
                      },
                      "speechSeconds": {
                        "type": "number",
                        "minimum": 0
                      },
                      "totalSeconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "totalRangeSeconds": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "basis": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "speechSeconds",
                      "totalSeconds",
                      "totalRangeSeconds",
                      "basis"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "measured"
                      },
                      "speechSeconds": {
                        "type": "number",
                        "minimum": 0
                      },
                      "totalSeconds": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "audioFile": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                      },
                      "audioSha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "kind",
                      "speechSeconds",
                      "totalSeconds",
                      "audioFile",
                      "audioSha256"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "assetRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                },
                "uniqueItems": true
              },
              "production": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "visualBlocks": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id"
                      ]
                    }
                  }
                }
              },
              "editReason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "sourceMapping",
              "timing",
              "assetRefs",
              "production"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "nonspoken": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "start",
              "end",
              "text",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "previews": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "minItems": 0
        },
        "requirementsNotes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "contractVersion",
        "taskId",
        "inputDigest",
        "scenes",
        "nonspoken",
        "previews",
        "requirementsNotes"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "video-two-stage/1"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "stage": {
          "const": "render"
        },
        "confirmedPlanSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planVersion": {
          "type": "integer",
          "minimum": 1
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "frames": {
                "type": "integer",
                "minimum": 1
              },
              "durationSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              "text": {
                "type": "string"
              },
              "usedResources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                    },
                    "kind": {
                      "enum": [
                        "source",
                        "generated"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "resolvedVisualBlocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                    },
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endFrameExclusive": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "startFrame",
                    "endFrameExclusive"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "audio": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "text"
                ],
                "additionalProperties": false
              },
              "captions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "startSeconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endSeconds": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "text",
                    "startSeconds",
                    "endSeconds"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "frame",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "frames",
              "durationSeconds",
              "id",
              "text",
              "usedResources",
              "resolvedVisualBlocks",
              "audio",
              "captions",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "wholeVideo": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "frames": {
                  "type": "integer",
                  "minimum": 1
                },
                "durationSeconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "path",
                "sha256",
                "frames",
                "durationSeconds"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        }
      },
      "required": [
        "contractVersion",
        "taskId",
        "runId",
        "stage",
        "confirmedPlanSha256",
        "planVersion",
        "scenes",
        "wholeVideo",
        "quality"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "video-two-stage/1"
        },
        "taskId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
        },
        "stage": {
          "enum": [
            "analysis",
            "render"
          ]
        },
        "confirmedPlanSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "passed": {
          "const": true
        },
        "humanListeningPerformed": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
              },
              "videoSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "viewedFrames": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "const": true
              }
            },
            "required": [
              "id",
              "videoSha256",
              "viewedFrames",
              "notes",
              "passed"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "contractVersion",
        "taskId",
        "runId",
        "stage",
        "confirmedPlanSha256",
        "passed",
        "humanListeningPerformed",
        "limitations",
        "scenes"
      ],
      "additionalProperties": false
    }
  }
}
