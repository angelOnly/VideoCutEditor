{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "auto"
    },
    "operation": {
      "enum": [
        "analysis",
        "render"
      ]
    },
    "planVersion": {
      "type": "integer",
      "minimum": 0
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "assetManifest": {
          "type": "string",
          "minLength": 1
        },
        "confirmedPlan": {
          "type": [
            "string",
            "null"
          ]
        },
        "narrationAssetId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "script",
        "assetManifest",
        "confirmedPlan",
        "narrationAssetId"
      ]
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "path"
      ]
    },
    "renderSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sceneIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reuseManifest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sceneIds",
        "reuseManifest"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "multipleOf": 2
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "requireAudio": {
          "const": true
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "requireAudio"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "type": "string",
          "minLength": 1
        },
        "repairRounds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "deadline",
        "repairRounds"
      ]
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "doubao"
        },
        "voiceId": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "voiceId",
        "resourceId"
      ]
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirements": {
      "type": "string"
    },
    "digitalHumanId": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "taskId",
    "mode",
    "operation",
    "planVersion",
    "input",
    "template",
    "renderSelection",
    "output",
    "limits",
    "tts",
    "threadId",
    "requirements",
    "digitalHumanId"
  ]
}
