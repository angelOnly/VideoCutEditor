{
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "status", "stage", "artifact", "error"],
  "properties": {
    "jobId": {"type": "string"},
    "status": {"type": "string", "enum": ["candidate", "failed"]},
    "stage": {"type": "string", "enum": ["input_check", "planning", "voiceover", "project", "timeline", "quality_check", "rendering", "delivery_check"]},
    "artifact": {"type": ["string", "null"]},
    "error": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
         "required": ["code", "message", "retryable"],
         "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}
      ]
    }
  }
}
